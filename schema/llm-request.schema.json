{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurogateway.local/schema/llm-request.schema.json",
  "title": "CanonicalChatRequest",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": ["system", "developer", "user", "assistant", "tool"],
            "type": "string"
          },
          "content": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "text",
                          "type": "string"
                        },
                        "text": {
                          "type": "string"
                        }
                      },
                      "required": ["type", "text"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "image_url",
                          "type": "string"
                        },
                        "image_url": {
                          "type": "object",
                          "properties": {
                            "url": {
                              "type": "string"
                            },
                            "detail": {
                              "enum": ["auto", "low", "high"],
                              "type": "string"
                            }
                          },
                          "required": ["url"],
                          "additionalProperties": false
                        }
                      },
                      "required": ["type", "image_url"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "file",
                          "type": "string"
                        },
                        "file": {
                          "type": "object",
                          "properties": {
                            "file_id": {
                              "type": "string"
                            },
                            "file_data": {
                              "type": "string"
                            },
                            "filename": {
                              "type": "string"
                            }
                          },
                          "required": [],
                          "additionalProperties": false,
                          "oneOf": [
                            {
                              "required": ["file_id"]
                            },
                            {
                              "required": ["file_data"]
                            }
                          ]
                        }
                      },
                      "required": ["type", "file"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "input_audio",
                          "type": "string"
                        },
                        "input_audio": {
                          "type": "object",
                          "properties": {
                            "data": {
                              "type": "string"
                            },
                            "format": {
                              "enum": ["wav", "mp3"],
                              "type": "string"
                            }
                          },
                          "required": ["data", "format"],
                          "additionalProperties": false
                        }
                      },
                      "required": ["type", "input_audio"],
                      "additionalProperties": false
                    }
                  ]
                },
                "minItems": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "tool_call_id": {
            "type": "string"
          },
          "tool_calls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "const": "function",
                  "type": "string"
                },
                "function": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "arguments": {
                      "type": "string"
                    }
                  },
                  "required": ["name", "arguments"],
                  "additionalProperties": false
                }
              },
              "required": ["id", "type", "function"],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "cache_control": {
            "type": "object",
            "properties": {
              "type": {
                "enum": ["ephemeral"],
                "type": "string"
              }
            },
            "required": ["type"],
            "additionalProperties": false
          }
        },
        "required": ["role"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "tool",
                  "type": "string"
                }
              }
            },
            "then": {
              "required": ["tool_call_id", "content"]
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "enum": ["system", "developer", "user"],
                  "type": "string"
                }
              }
            },
            "then": {
              "required": ["content"],
              "properties": {
                "content": {
                  "not": {
                    "type": "null"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "assistant",
                  "type": "string"
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "required": ["content"]
                },
                {
                  "required": ["tool_calls"]
                }
              ]
            }
          }
        ]
      },
      "minItems": 1
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "top_p": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "top_k": {
      "type": "integer",
      "minimum": 0
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "max_completion_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "stop": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      ]
    },
    "seed": {
      "type": "integer"
    },
    "frequency_penalty": {
      "type": "number",
      "minimum": -2,
      "maximum": 2
    },
    "presence_penalty": {
      "type": "number",
      "minimum": -2,
      "maximum": 2
    },
    "logprobs": {
      "type": "boolean"
    },
    "top_logprobs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "logit_bias": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": -100,
        "maximum": 100
      }
    },
    "response_format": {
      "type": "object",
      "properties": {
        "type": {
          "enum": ["text", "json_object", "json_schema"],
          "type": "string"
        },
        "json_schema": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "const": "function",
            "type": "string"
          },
          "function": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "parameters": {
                "type": "object",
                "additionalProperties": true
              },
              "strict": {
                "type": "boolean"
              }
            },
            "required": ["name"],
            "additionalProperties": false
          }
        },
        "required": ["type", "function"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "tool_choice": {
      "oneOf": [
        {
          "enum": ["none", "auto", "required"],
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "function",
              "type": "string"
            },
            "function": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "required": ["name"],
              "additionalProperties": false
            }
          },
          "required": ["type", "function"],
          "additionalProperties": false
        }
      ]
    },
    "parallel_tool_calls": {
      "type": "boolean"
    },
    "reasoning": {
      "type": "object",
      "properties": {
        "effort": {
          "enum": ["none", "minimal", "low", "medium", "high"],
          "type": "string"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "exclude": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "prediction": {
      "type": "object",
      "properties": {
        "type": {
          "const": "content",
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "user": {
      "type": "string"
    },
    "stream": {
      "type": "boolean"
    },
    "stream_options": {
      "type": "object",
      "properties": {
        "include_usage": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "store": {
      "const": false,
      "type": "boolean"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "provider": {
      "type": "object",
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "allow_fallbacks": {
          "type": "boolean"
        },
        "require_parameters": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "transforms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "preset": {
      "type": "string"
    }
  },
  "required": ["model", "messages"],
  "additionalProperties": false
}
