{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurogateway.local/schema/llm-response.schema.json",
  "title": "CanonicalChatResponse",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "object": {
      "const": "chat.completion",
      "type": "string"
    },
    "created": {
      "type": "integer",
      "minimum": 0
    },
    "model": {
      "type": "string"
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "object",
            "properties": {
              "role": {
                "enum": ["system", "developer", "user", "assistant", "tool"],
                "type": "string"
              },
              "content": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "const": "text",
                              "type": "string"
                            },
                            "text": {
                              "type": "string"
                            }
                          },
                          "required": ["type", "text"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "const": "image_url",
                              "type": "string"
                            },
                            "image_url": {
                              "type": "object",
                              "properties": {
                                "url": {
                                  "type": "string"
                                },
                                "detail": {
                                  "enum": ["auto", "low", "high"],
                                  "type": "string"
                                }
                              },
                              "required": ["url"],
                              "additionalProperties": false
                            }
                          },
                          "required": ["type", "image_url"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "const": "file",
                              "type": "string"
                            },
                            "file": {
                              "type": "object",
                              "properties": {
                                "file_id": {
                                  "type": "string"
                                },
                                "file_data": {
                                  "type": "string"
                                },
                                "filename": {
                                  "type": "string"
                                }
                              },
                              "required": [],
                              "additionalProperties": false,
                              "oneOf": [
                                {
                                  "required": ["file_id"]
                                },
                                {
                                  "required": ["file_data"]
                                }
                              ]
                            }
                          },
                          "required": ["type", "file"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "const": "input_audio",
                              "type": "string"
                            },
                            "input_audio": {
                              "type": "object",
                              "properties": {
                                "data": {
                                  "type": "string"
                                },
                                "format": {
                                  "enum": ["wav", "mp3"],
                                  "type": "string"
                                }
                              },
                              "required": ["data", "format"],
                              "additionalProperties": false
                            }
                          },
                          "required": ["type", "input_audio"],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "minItems": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "type": "string"
              },
              "tool_call_id": {
                "type": "string"
              },
              "tool_calls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "type": {
                      "const": "function",
                      "type": "string"
                    },
                    "function": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "arguments": {
                          "type": "string"
                        }
                      },
                      "required": ["name", "arguments"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["id", "type", "function"],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "reasoning": {
                "type": "string"
              },
              "reasoning_content": {
                "type": "string"
              }
            },
            "required": ["role"],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "role": {
                      "const": "tool",
                      "type": "string"
                    }
                  }
                },
                "then": {
                  "required": ["tool_call_id", "content"]
                }
              },
              {
                "if": {
                  "properties": {
                    "role": {
                      "enum": ["system", "developer", "user"],
                      "type": "string"
                    }
                  }
                },
                "then": {
                  "required": ["content"],
                  "properties": {
                    "content": {
                      "not": {
                        "type": "null"
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "role": {
                      "const": "assistant",
                      "type": "string"
                    }
                  }
                },
                "then": {
                  "anyOf": [
                    {
                      "required": ["content"]
                    },
                    {
                      "required": ["tool_calls"]
                    }
                  ]
                }
              }
            ]
          },
          "finish_reason": {
            "enum": ["stop", "length", "tool_calls", "content_filter", "error"],
            "type": "string"
          }
        },
        "required": ["index", "message", "finish_reason"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "usage": {
      "type": "object",
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "audio_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "audio_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "image_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "image_output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
      "additionalProperties": false
    }
  },
  "required": ["id", "object", "created", "model", "choices", "usage"],
  "additionalProperties": false
}
